{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window; also Work's pop-out windows (work-*). Named by web view, never by window: a thing's child web view inside the main window (thing.rs) matches no capability",
  "webviews": [
    "main",
    "work-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-create",
    "core:window:allow-set-badge-count",
    "core:window:allow-request-user-attention",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "allow-engine-port",
    "allow-notch-expand",
    "allow-notch-geometry",
    "allow-face-log",
    "allow-face-mode",
    "allow-face-state",
    "allow-vibe-start",
    "allow-vibe-stop",
    "allow-vibe-glow",
    "allow-thing-open",
    "allow-thing-show",
    "allow-thing-bounds",
    "allow-thing-close",
    "allow-thing-nav",
    "allow-thing-outside",
    "allow-sites-sign-out",
    "allow-sites-clear",
    "allow-sol-url-take",
    "allow-install-run",
    "allow-claude-login",
    "allow-claude-status",
    "allow-codex-login",
    "allow-codex-status",
    "allow-claude-install",
    "allow-welcome-done",
    "allow-engine-start",
    "allow-engine-phase",
    "allow-idle-seconds",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/**"
        }
      ]
    }
  ]
}
