# Sol's keys on your Mac. sol/setup writes sol/engine/.env from these names; or copy this file to .env and fill it.
# .env is gitignored and stays on your machine. Never copy someone else's values.

# Gemini API key (https://aistudio.google.com/apikey): voice calls and conversation names.
GEMINI_API_KEY=

# ElevenLabs API key (https://elevenlabs.io/app/settings/api-keys): when set, calls hear and talk through ElevenLabs
# and Sol's own seat answers (Settings → voice → maker can still pick Gemini). Empty: calls use Gemini Live.
ELEVENLABS_API_KEY=

# Your own Tailscale login (the email you signed in to Tailscale with): who may open your engine's tailnet door.
SOL_OWNER=

# The team relay is not set here: sol/setup writes SOL_RELAY (the team gives you the address, as wss://HOST/relay) to
# sol/engine/team.json; with none, this Sol runs on its own.
# It is a WebSocket address (wss://, path /relay) because the engine joins the relay over a WebSocket and drops an https:// one.

# The hub every room meets on, and where a room's six-symbol code is looked up (#157). Empty: Sol's cloud,
# wss://cloud.matterfold.tech/relay (S6b). Your own hub: its address, wss://HOST/relay. off: a room you make meets on this
# engine's own relay.
SOL_HUB=
# Hubs that moved, old=>new, comma between: a room kept on the old one follows. Sol knows the NucBox's move to the cloud
# by itself (rooms with a share code); `off` here turns that off.
SOL_HUB_MOVED=
# On the hub itself: the host(s) it answers at, as a Sol dials it (hub.example.net, or host:port), comma between. A
# Sol proves who it is on GitHub with a gist naming one of these (hub/proof.ts); none set, the hub gives no tickets.
SOL_HUB_HOST=
