# Sol's keys on your Mac. sol/setup writes sol/engine/.env from these names; or copy this file to .env and fill it.
# .env is gitignored and stays on your machine. Never copy someone else's values.

# Gemini API key (https://aistudio.google.com/apikey): voice calls and conversation names.
GEMINI_API_KEY=

# Your own Tailscale login (the email you signed in to Tailscale with): who may open your engine's tailnet door.
SOL_OWNER=

# The team relay is not set here: sol/setup writes SOL_RELAY (the team gives you the address, as wss://HOST/relay) to
# sol/engine/team.json; with none, this Sol runs on its own.
# It is a WebSocket address (wss://, path /relay) because the engine joins the relay over a WebSocket and drops an https:// one.
